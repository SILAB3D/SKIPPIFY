VITE_FIREBASE_AUTH_DOMAIN=skipp-7d184.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=skipp-7d184
VITE_FIREBASE_STORAGE_BUCKET=skipp-7d184.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=531749017831
VITE_FIREBASE_APP_ID=1:531749017831:web:41060f8578227d3e9aaa42
