rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/friend_groups/$(groupId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /listening_events/{eventId} {
        allow read, write: if isOwner(uid);
      }

      match /league_weekly_stats/{weekId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /friend_groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid) || (isSignedIn() && get(/databases/$(database)/documents/friend_groups/$(groupId)).data.ownerUid == request.auth.uid);
      }

      match /weekly_results/{weekId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }
    }
  }
}
